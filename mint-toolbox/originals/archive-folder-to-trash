#!/bin/bash
#!/usr/bin/env bash
set -Eeuo pipefail

usage() {
  echo "Usage: $0 FOLDER [OUTPUT_DIR]" >&2
  echo "Example: $0 ~/Videos/OldFolder" >&2
  exit 2
}

[[ $# -ge 1 && $# -le 2 ]] || usage

# WARNING: concurrent source writes cannot be excluded; this tool only archives.
# Move originals manually after reviewing the archive and closing all writers.
src="$1"
while [[ "$src" == */ && "$src" != / ]]; do src="${src%/}"; done
[[ "$src" != / ]] || { echo 'ERROR: Refusing to archive the filesystem root.' >&2; exit 1; }
[[ ! -L "$src" ]] || { echo 'ERROR: Select the real directory, not a symbolic link.' >&2; exit 1; }

if [[ ! -d "$src" ]]; then
  echo "Error: not a folder: $src" >&2
  exit 1
fi

src_abs="$(realpath -e -- "$src")"
parent="$(dirname -- "$src_abs")"
base="$(basename -- "$src_abs")"

outdir="${2:-$parent}"
mkdir -p -- "$outdir"
outdir_abs="$(realpath -m -- "$outdir")"

# Do not create the archive inside the folder being archived.
case "$outdir_abs/" in
  "$src_abs"/*)
    echo "Error: output directory cannot be inside the source folder." >&2
    exit 1
    ;;
esac

stamp="$(date +%Y%m%d-%H%M%S)"
archive="$outdir_abs/${base}-${stamp}.tar.gz"
tmp_archive="$(mktemp "$outdir_abs/.archive.XXXXXXXX.tar.gz")"

cleanup() {
  [[ -f "$tmp_archive" ]] && rm -f -- "$tmp_archive"
}
trap cleanup EXIT

echo "Archiving:"
echo "  Source:  $src_abs"
echo "  Archive: $archive"
echo

tar -C "$parent" -czf "$tmp_archive" -- "$base"

echo "Testing archive structure..."
tar -tzf "$tmp_archive" >/dev/null

ln -- "$tmp_archive" "$archive"
rm -- "$tmp_archive"
trap - EXIT

echo
echo "Archive created successfully:"
echo "  $archive"
echo
echo
echo "Preview of archive contents:"
set +o pipefail
tar -tzf "$archive" | head -80
set -o pipefail

echo
echo "WARNING: Originals retained. A live source may change during or after compression."
echo "Close all writers and inspect the archive before moving originals manually."
