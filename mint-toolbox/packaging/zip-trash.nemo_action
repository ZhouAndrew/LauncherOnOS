[Nemo Action]
Active=true
Name=Create verified ZIP (keep originals)
Comment=Verify ZIP contents and keep originals; automatic Trash is unsafe with concurrent writes
Exec=/usr/bin/mint-toolbox-zip-trash --gui %F
Icon-Name=package-x-generic
Selection=notnone
Extensions=any;
Dependencies=zip;unzip;gio;/usr/bin/mint-toolbox-zip-trash;
Quote=double
UriScheme=file
