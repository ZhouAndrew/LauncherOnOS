#!/usr/bin/python3
"""Standalone Link Provider for a Linux desktop session."""

import argparse
from contextlib import contextmanager
import ctypes
import fcntl
import getpass
import hashlib
import hmac
from http.server import BaseHTTPRequestHandler, HTTPServer, ThreadingHTTPServer
import threading
import json
import os
from pathlib import Path
import re
import shutil
import stat
import ssl
import time
import subprocess
import sys
import tempfile
from urllib.error import HTTPError, URLError
from urllib.parse import parse_qs, urlsplit
from urllib.request import HTTPRedirectHandler, Request, build_opener

VERSION = "0.3.0"
SCHEME = "caldav-run"
MIME_TYPE = f"x-scheme-handler/{SCHEME}"
DESKTOP_ID = "local.link-provider.desktop"
LINK_ID = re.compile(r"[a-z0-9][a-z0-9-]{0,62}")
ALIAS = re.compile(rf"{SCHEME}://({LINK_ID.pattern})")
SCHEME_PATTERN = re.compile(r"[a-zA-Z][a-zA-Z0-9+.-]*")
WEB_SCHEMES = {"http", "https"}
PR_SET_NO_NEW_PRIVS = 38
ELEVATION_TOOLS = {
    "sudo", "sudoedit", "su", "runuser", "doas", "pkexec", "run0", "systemd-run",
    "gksu", "gksudo", "kdesu", "kdesudo", "gsudo", "please", "pleaseedit",
}


class LinkError(Exception):
    pass


def xdg_path(variable, fallback):
    path = Path(os.environ.get(variable, ""))
    return path if path.is_absolute() else Path.home() / fallback


def registry_path():
    return xdg_path("XDG_CONFIG_HOME", ".config") / "link-provider" / "links.json"


def handler_path():
    return xdg_path("XDG_DATA_HOME", ".local/share") / "applications" / DESKTOP_ID


def parse_id(value):
    parts = value.split("://", 1)
    if len(parts) == 2:
        if parts[0].lower() not in configured_schemes():
            raise LinkError("This desktop scheme is not configured.")
        name = parts[1]
    else:
        name = value
    if not LINK_ID.fullmatch(name):
        raise LinkError("Use a lowercase link ID or an exact caldav-run://ID URI.")
    return name



def settings_path(name):
    return registry_path().with_name(name + ".json")


def configured_schemes():
    try:
        values = json.loads(settings_path("schemes").read_text())
    except FileNotFoundError:
        return [SCHEME]
    if (not isinstance(values, list) or not values or SCHEME not in values
            or any(not isinstance(value, str) or not SCHEME_PATTERN.fullmatch(value)
                   or value != value.lower() or value in WEB_SCHEMES
                   or value in {"file", "data", "javascript"} for value in values)):
        raise LinkError("Invalid desktop scheme settings.")
    return values


def configure_scheme(args):
    require_desktop_user()
    value = args.scheme.lower()
    if (not SCHEME_PATTERN.fullmatch(value) or value in WEB_SCHEMES
            or value in {"file", "data", "javascript"}):
        raise LinkError("Choose a custom scheme, for example study or anki-run.")
    with write_lock():
        values = configured_schemes()
        if value not in values:
            values.append(value)
        atomic_write(settings_path("schemes"), (json.dumps(values) + "\n").encode())
    print("Saved scheme: " + value)


def lan_settings():
    try:
        result = json.loads(settings_path("lan-settings").read_text())
    except FileNotFoundError:
        return {}
    if not isinstance(result, dict):
        raise LinkError("Invalid LAN settings.")
    return result


def configure_lan(args):
    require_desktop_user()
    if not re.fullmatch(r"[a-zA-Z0-9][a-zA-Z0-9.-]{0,252}", args.host):
        raise LinkError("Use the Mint hostname or IPv4 address reached by the other device.")
    if args.http_port == args.port:
        raise LinkError("HTTP and HTTPS require different ports.")
    cert, key = args.cert, args.key
    with write_lock():
        if not cert and not key:
            folder = registry_path().parent
            cert, key = str(folder / "lan-cert.pem"), str(folder / "lan-key.pem")
            if Path(cert).exists() != Path(key).exists():
                raise LinkError("Certificate setup is incomplete. Choose a certificate and key.")
            if not Path(cert).exists():
                with tempfile.TemporaryDirectory(dir=folder) as temporary:
                    staged = Path(temporary)
                    san = ("IP:" if re.fullmatch(r"[0-9.]+", args.host) else "DNS:") + args.host
                    subprocess.run([executable("openssl"), "req", "-x509", "-newkey", "rsa:3072",
                                    "-nodes", "-days", "365", "-subj", "/CN=" + args.host,
                                    "-addext", "subjectAltName=" + san,
                                    "-keyout", str(staged / "key"), "-out", str(staged / "cert")],
                                   stdout=subprocess.DEVNULL, stderr=subprocess.PIPE, check=True, timeout=30)
                    os.chmod(staged / "key", 0o600)
                    os.replace(staged / "key", key)
                    os.replace(staged / "cert", cert)
        if not cert or not key:
            raise LinkError("Select both the certificate and its private key.")
        context = ssl.SSLContext(ssl.PROTOCOL_TLS_SERVER)
        context.load_cert_chain(cert, key)
        config = dict(bind=args.bind, host=args.host, port=args.port,
                      http_port=args.http_port, cert=str(Path(cert).resolve()), key=str(Path(key).resolve()))
        atomic_write(settings_path("lan-settings"), (json.dumps(config, indent=2) + "\n").encode())
    print("LAN settings saved. Trust the selected certificate on the other device before entering a password.")


def save_lan_password(password, repeated):
    require_desktop_user()
    if len(password) < 12 or len(password.encode()) > 512:
        raise LinkError("Use at least 12 characters and at most 512 UTF-8 bytes.")
    if password != repeated:
        raise LinkError("The passwords did not match.")
    salt = os.urandom(16)
    digest = hashlib.scrypt(password.encode(), salt=salt, n=32768, r=8, p=1, maxmem=64 * 1024**2)
    with write_lock():
        atomic_write(registry_path().with_name("lan-password"), salt + digest)
    print("LAN password saved.")


def serve_saved_lan(_args):
    config = lan_settings()
    if not config:
        raise LinkError("Configure LAN access first.")
    serve_lan(argparse.Namespace(**config))


def validate_uri(uri):
    if any(char.isspace() or ord(char) < 32 or ord(char) == 127 for char in uri):
        raise LinkError("The URI contains spaces or control characters. Percent-encode them.")
    scheme, separator, target = uri.partition(":")
    if not separator or not SCHEME_PATTERN.fullmatch(scheme) or not target:
        raise LinkError("Enter an absolute URI with a scheme and a destination.")
    scheme = scheme.lower()
    if scheme in {*configured_schemes(), "file", "data", "javascript"}:
        raise LinkError(f"Unsupported target scheme: {scheme}. Use add-app for a local program.")
    if scheme in WEB_SCHEMES:
        try:
            parts = urlsplit(uri)
            hostname = parts.hostname
            parts.port  # Accessing the port checks its syntax and range.
        except ValueError as exc:
            raise LinkError("Invalid HTTP(S) host or port.") from exc
        if not hostname or "\\" in uri or parts.username is not None:
            raise LinkError("Use an HTTP(S) URI with a hostname and no embedded credentials.")
    return scheme


def executable(command):
    if not command or "\0" in command or ("/" in command and not Path(command).is_absolute()):
        raise LinkError("Use a program name from PATH or an absolute executable path.")
    resolved = shutil.which(command)
    if not resolved:
        raise LinkError(f"Executable unavailable: {command}")
    return os.path.abspath(resolved)


def command_target(command, arguments):
    if Path(command).name in ELEVATION_TOOLS:
        raise LinkError("Privilege elevation tools such as sudo are blocked.")
    program = executable(command)
    real_path = Path(program).resolve(strict=True)
    if (real_path.name in ELEVATION_TOOLS
            or real_path.stat().st_mode & (stat.S_ISUID | stat.S_ISGID)):
        raise LinkError("Privilege elevation tools and set-ID executables are blocked.")
    if any("\0" in argument for argument in arguments):
        raise LinkError("Command arguments cannot contain NUL characters.")
    return [program, *arguments]


def require_desktop_user():
    if 0 in {os.getuid(), os.geteuid()} or os.getuid() != os.geteuid():
        raise LinkError("Run Link Provider as your regular desktop user.")


def lock_privileges():
    require_desktop_user()
    libc = ctypes.CDLL(None, use_errno=True)
    prctl = libc.prctl
    prctl.argtypes = [ctypes.c_int, *([ctypes.c_ulong] * 4)]
    prctl.restype = ctypes.c_int
    if prctl(PR_SET_NO_NEW_PRIVS, 1, 0, 0, 0) != 0:
        raise LinkError(f"Could not prevent privilege elevation: {os.strerror(ctypes.get_errno())}")


@contextmanager
def write_lock():
    directory = registry_path().parent
    directory.mkdir(mode=0o700, parents=True, exist_ok=True)
    with (directory / "write.lock").open("a") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        yield


def read_links():
    try:
        links = json.loads(registry_path().read_text(encoding="utf-8"))
    except FileNotFoundError:
        return {}
    except ValueError as exc:
        raise LinkError("The link registry could not be decoded.") from exc
    if not isinstance(links, dict):
        raise LinkError("Invalid link registry.")
    for name, entry in links.items():
        if not LINK_ID.fullmatch(name) or not isinstance(entry, dict):
            raise LinkError("Invalid entry in the link registry.")
        target = entry.get("target")
        kind = entry.get("kind")
        valid_target = (
            (kind == "uri" and isinstance(target, str))
            or (kind == "app" and isinstance(target, list) and target
                and all(isinstance(arg, str) for arg in target))
        )
        if (not valid_target or not isinstance(entry.get("enabled"), bool)
                or not isinstance(entry.get("allow_lan", False), bool)
                or (entry.get("allow_lan", False) and kind != "app")):
            raise LinkError(f"Invalid entry in the link registry: {name}")
    return links


def atomic_write(path, content):
    with tempfile.NamedTemporaryFile(dir=path.parent, delete=False) as temporary:
        staged = Path(temporary.name)
        try:
            temporary.write(content)
            temporary.flush()
            os.fsync(temporary.fileno())
            temporary.close()
            os.replace(staged, path)
        finally:
            staged.unlink(missing_ok=True)


def get_entry(links, name):
    if name not in links:
        raise LinkError(f"Unknown link: {name}")
    return links[name]


def change_link(args):
    name = parse_id(args.id)
    action = args.action
    with write_lock():
        links = read_links()
        if action in {"add", "add-app"}:
            if name in links:
                raise LinkError(f"Link already exists: {name}")
            enabled = True
        else:
            enabled = get_entry(links, name)["enabled"]

        if action == "remove":
            del links[name]
        elif action in {"enable", "disable"}:
            links[name]["enabled"] = action == "enable"
        elif action in {"allow-lan", "deny-lan"}:
            if links[name]["kind"] != "app":
                raise LinkError("Only application presets can be authorized for LAN access.")
            links[name]["allow_lan"] = action == "allow-lan"
        elif action in {"add-app", "edit-app"}:
            target = command_target(args.program, args.arguments)
            links[name] = {"kind": "app", "target": target, "enabled": enabled}
        else:
            validate_uri(args.uri)
            links[name] = {"kind": "uri", "target": args.uri, "enabled": enabled}

        content = json.dumps(links, indent=2, ensure_ascii=False, sort_keys=True) + "\n"
        atomic_write(registry_path(), content.encode("utf-8"))
        if read_links() != links:
            raise LinkError("The saved registry did not match the requested change.")
    print(f"{action}: {name} (verified)")


def system_command(*command, stable_locale=False):
    result = subprocess.run(
        [executable(command[0]), *command[1:]],
        stdin=subprocess.DEVNULL,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        env={**os.environ, "LC_ALL": "C"} if stable_locale else None,
        timeout=10,
    )
    if result.returncode:
        error = result.stderr.decode(errors="replace").strip()
        raise LinkError(error or f"{command[0]} exited with status {result.returncode}.")
    return result.stdout.decode(errors="replace")


def default_handler(mime_type):
    output = system_command("gio", "mime", mime_type, stable_locale=True)
    for line in output.splitlines():
        if line.startswith("Default application "):
            return line.rpartition(": ")[2]
    return None


def require_handler(scheme):
    handler = default_handler(f"x-scheme-handler/{scheme}")
    if not handler:
        raise LinkError(f"No desktop application handles {scheme}: URIs.")
    return handler


class WebRedirectHandler(HTTPRedirectHandler):
    def redirect_request(self, req, fp, code, msg, headers, newurl):
        if validate_uri(newurl) not in WEB_SCHEMES:
            raise LinkError("The service redirected outside HTTP(S).")
        return super().redirect_request(req, fp, code, msg, headers, newurl)


def check_web(uri):
    opener = build_opener(WebRedirectHandler())
    try:
        with opener.open(Request(uri, headers={"User-Agent": f"LinkProvider/{VERSION}"}), timeout=5) as response:
            return f"HTTP {response.status}"
    except HTTPError as exc:
        exc.close()
        raise LinkError(f"The service returned HTTP {exc.code}.") from exc
    except (URLError, UnicodeError) as exc:
        raise LinkError(f"The service could not be reached: {exc}") from exc


def launch_application(name, command):
    lock_privileges()
    process = subprocess.Popen(
        command,
        stdin=subprocess.DEVNULL,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        start_new_session=True,
    )
    # Process creation is not application readiness. Catch early
    # nonzero exits, especially missing local backends, but do not
    # block the desktop for long-running GUI applications.
    try:
        code = process.wait(timeout=0.35)
    except subprocess.TimeoutExpired:
        return f"Dispatched: {name} (PID {process.pid}); application/backend readiness not verified."
    else:
        if code:
            raise LinkError(f"Application exited immediately with code {code}: {name}. Check its backend and logs.")
        return f"Command exited with code 0: {name}; application/backend readiness not verified."


def set_lan_password(args):
    if args.stdin:
        values = json.loads(sys.stdin.readline(4096))
        save_lan_password(values["password"], values["repeat"])
    else:
        save_lan_password(getpass.getpass("Link Provider password: "),
                          getpass.getpass("Repeat password: "))


def serve_lan(args):
    lock_privileges()
    if not re.fullmatch(r"[a-zA-Z0-9][a-zA-Z0-9.-]*", args.host):
        raise LinkError("Specify the hostname or IPv4 address used by remote clients.")
    authority = args.host if args.port == 443 else f"{args.host}:{args.port}"
    origin = f"https://{authority}"
    credential = registry_path().with_name("lan-password")
    if len(credential.read_bytes()) != 80:
        raise LinkError("Set a Link Provider password before serving requests.")
    context = ssl.SSLContext(ssl.PROTOCOL_TLS_SERVER)
    context.minimum_version = ssl.TLSVersion.TLSv1_2
    context.load_cert_chain(args.cert, args.key)
    retry_at = 0.0

    class Server(HTTPServer):
        def get_request(self):
            connection, address = super().get_request()
            connection.settimeout(3)
            try:
                return context.wrap_socket(connection, server_side=True), address
            except OSError:
                connection.close()
                raise

    class Handler(BaseHTTPRequestHandler):
        def log_message(self, *_args):
            pass

        def respond(self, status, body, content_type="text/plain; charset=utf-8"):
            data = body.encode()
            self.send_response(status)
            self.send_header("Content-Type", content_type)
            self.send_header("Content-Length", str(len(data)))
            self.send_header("Cache-Control", "no-store")
            self.send_header("Content-Security-Policy", "default-src 'none'; form-action 'self'; frame-ancestors 'none'; base-uri 'none'")
            self.send_header("X-Content-Type-Options", "nosniff")
            self.end_headers()
            self.wfile.write(data)

        def preset_id(self):
            match = re.fullmatch(r"/run/(" + LINK_ID.pattern + ")", self.path)
            if self.headers.get_all("Host") != [authority] or match is None:
                self.respond(404, "Unknown link.")
                return None
            return match[1]

        def do_GET(self):
            name = self.preset_id()
            if name is not None:
                self.respond(200, f"""<!doctype html>
<html lang="en"><meta charset="utf-8"><meta name="viewport" content="width=device-width">
<title>Run {name}</title><h1>Run {name}</h1>
<form method="post"><label>Link Provider password
<input name="password" type="password" required autocomplete="current-password"></label>
<button>Run</button></form></html>""", "text/html; charset=utf-8")

        def do_POST(self):
            nonlocal retry_at
            name = self.preset_id()
            if name is None:
                return
            if self.headers.get_all("Origin") != [origin]:
                self.respond(403, "Open the run page directly before submitting.")
                return
            lengths = self.headers.get_all("Content-Length", [])
            if (len(lengths) != 1 or not re.fullmatch(r"[0-9]{1,4}", lengths[0])
                    or not 0 < int(lengths[0]) <= 2048
                    or self.headers.get("Transfer-Encoding") is not None
                    or self.headers.get_content_type() != "application/x-www-form-urlencoded"):
                self.respond(400, "Invalid form.")
                return
            if time.monotonic() < retry_at:
                self.respond(429, "Wait before trying again.")
                return
            try:
                fields = parse_qs(self.rfile.read(int(lengths[0])).decode("ascii"),
                                  strict_parsing=True, max_num_fields=1, errors="strict")
                if set(fields) != {"password"}:
                    raise ValueError
                password = fields["password"][0].encode()
                if len(password) > 512:
                    raise ValueError
            except ValueError:
                self.respond(400, "Invalid form.")
                return
            try:
                saved = credential.read_bytes()
                if len(saved) != 80:
                    raise LinkError("Password is unavailable.")
                digest = hashlib.scrypt(password, salt=saved[:16], n=32768, r=8, p=1,
                                        maxmem=64 * 1024**2)
                if not hmac.compare_digest(digest, saved[16:]):
                    retry_at = time.monotonic() + 2
                    self.respond(403, "Password verification failed.")
                    return
                entry = read_links().get(name)
                if (not entry or entry["kind"] != "app" or not entry["enabled"]
                        or not entry.get("allow_lan", False)):
                    self.respond(404, "Preset is unavailable for LAN execution.")
                    return
                target = entry["target"]
                result = launch_application(name, command_target(target[0], target[1:]))
            except (OSError, LinkError, ValueError):
                self.respond(500, "Launch failed. Check the preset on Mint.")
                return
            self.respond(200, result)

    class RedirectHandler(BaseHTTPRequestHandler):
        def log_message(self, *_args):
            pass

        def do_GET(self):
            match = re.fullmatch(r"/run/(" + LINK_ID.pattern + ")", self.path)
            http_authority = args.host if args.http_port == 80 else f"{args.host}:{args.http_port}"
            if match is None or self.headers.get_all("Host") != [http_authority]:
                self.send_error(404)
                return
            self.send_response(303)
            self.send_header("Location", origin + self.path)
            self.send_header("Content-Length", "0")
            self.send_header("Cache-Control", "no-store")
            self.end_headers()

        def do_POST(self):
            self.send_error(405, "Open the HTTPS run page before entering your password.")

    redirect = None
    with Server((args.bind, args.port), Handler) as server:
        try:
            if args.http_port:
                redirect = ThreadingHTTPServer((args.bind, args.http_port), RedirectHandler)
                redirect.daemon_threads = True
                threading.Thread(target=redirect.serve_forever, daemon=True).start()
            print(f"Listening at {origin}", flush=True)
            server.serve_forever()
        finally:
            if redirect:
                redirect.shutdown()
                redirect.server_close()


def use_link(args):
    name = parse_id(args.id)
    entry = get_entry(read_links(), name)
    if not entry["enabled"]:
        raise LinkError(f"Link is disabled: {name}")
    target = entry["target"]
    opening = args.action in {"open", "test"}
    if entry["kind"] == "app":
        command = command_target(target[0], target[1:])
        if opening:
            print(launch_application(name, command))
        else:
            print(f"Executable available: {command[0]}")
        return
    scheme = validate_uri(target)
    if opening:
        require_desktop_user()
        require_handler(scheme)
        system_command("gio", "open", scheme + target[target.index(":"):])
        print(f"Sent to desktop handler: {name}")
    elif scheme in WEB_SCHEMES:
        print(f"Service responded: {name} ({check_web(target)})")
    else:
        print(f"Desktop handler available: {require_handler(scheme)}")


def copy_to_clipboard(value):
    if os.environ.get("WAYLAND_DISPLAY") and shutil.which("wl-copy"):
        command = ["wl-copy", "--type", "text/plain;charset=utf-8"]
    elif os.environ.get("DISPLAY") and shutil.which("xclip"):
        command = ["xclip", "-selection", "clipboard"]
    elif os.environ.get("DISPLAY") and shutil.which("xsel"):
        command = ["xsel", "--clipboard", "--input"]
    else:
        raise LinkError("No clipboard tool available. Use 'link' to print the URI, or use wl-copy, xclip or xsel.")
    result = subprocess.run(
        command, input=value.encode("utf-8"), stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL, timeout=5,
    )
    if result.returncode:
        raise LinkError(f"Clipboard write failed: {command[0]}")


def share_link(args):
    name = parse_id(args.id)
    entry = get_entry(read_links(), name)
    if not entry["enabled"]:
        raise LinkError(f"Link is disabled: {name}")
    if args.target:
        if entry["kind"] != "uri":
            raise LinkError("A local program has no public target URI. Use its caldav-run alias.")
        value = entry["target"]
    else:
        scheme = args.scheme or SCHEME
        if scheme not in configured_schemes():
            raise LinkError("Configure this desktop scheme first.")
        value = f"{scheme}://{name}"
    if args.marker:
        value = f"CALDAV-OPEN:{value}"
    if args.action == "copy":
        copy_to_clipboard(value)
        print("Copied to clipboard.")
    else:
        print(value)


def desktop_exec_argument(value):
    if any(ord(char) < 32 or ord(char) == 127 for char in value):
        raise LinkError("The desktop launcher path contains a control character.")
    quoted = re.sub(r'(["`$\\])', r'\\\1', value.replace("%", "%%"))
    return '"' + quoted.replace("\\", "\\\\") + '"'


def desktop_exec_line():
    script = desktop_exec_argument(str(Path(__file__).resolve()))
    return f"Exec={script} desktop %u"


def change_handler(args):
    require_desktop_user()
    path = handler_path()
    with write_lock():
        schemes = configured_schemes()
        removing = args.action == "unregister-handler"
        current = default_handler(MIME_TYPE)
        for scheme in schemes:
            other = default_handler(f"x-scheme-handler/{scheme}")
            if other and other != DESKTOP_ID and not removing:
                raise LinkError(f"Another desktop handler is already active for {scheme}: {other}")
        if not removing and current and current != DESKTOP_ID:
            raise LinkError(f"Another desktop handler is already active: {current}")
        previous = path.read_bytes() if path.exists() else None
        if removing and previous is None:
            if current == DESKTOP_ID:
                raise LinkError("The active Link Provider handler is outside the current user's applications directory.")
            print("Desktop handler already absent (verified).")
            return

        executable("update-desktop-database")
        if removing:
            path.unlink()
        else:
            path.parent.mkdir(parents=True, exist_ok=True)
            try_exec = str(Path(__file__).resolve()).replace("\\", "\\\\")
            content = (
                "[Desktop Entry]\nType=Application\nName=Link Provider\n"
                "Comment=Manage and open your registered links\n"
                f"{desktop_exec_line()}\n"
                f"TryExec={try_exec}\nNoDisplay=true\n"
                f"MimeType={';'.join('x-scheme-handler/' + scheme for scheme in schemes)};\n"
            ).encode("utf-8")
            atomic_write(path, content)
        try:
            system_command("update-desktop-database", str(path.parent))
            active = all(default_handler(f"x-scheme-handler/{scheme}") == DESKTOP_ID for scheme in schemes)
            if removing:
                active = any(default_handler(f"x-scheme-handler/{scheme}") == DESKTOP_ID for scheme in schemes)
            saved = not path.exists() if removing else path.read_bytes() == content
            if active == removing or not saved:
                raise LinkError("The desktop handler change could not be verified.")
        except (LinkError, OSError, subprocess.TimeoutExpired):
            if previous is None:
                path.unlink(missing_ok=True)
            else:
                atomic_write(path, previous)
            system_command("update-desktop-database", str(path.parent))
            raise
    if removing:
        print("Desktop handler removed (verified).")
    else:
        print(f"Desktop handler active (verified): {SCHEME}://ID")


def list_links(args):
    links = read_links()
    if args.json:
        print(json.dumps(links, ensure_ascii=False, sort_keys=True))
        return
    for name, entry in sorted(links.items()):
        state = "enabled" if entry["enabled"] else "disabled"
        print(f"{name}\t{state}\t{entry['kind']}\t{entry['target']}")


def show_handler(args):
    handler = default_handler(MIME_TYPE)
    if not args.details:
        print(handler or "No desktop handler registered.")
        return
    current = False
    if handler == DESKTOP_ID:
        try:
            content = handler_path().read_text(encoding="utf-8").splitlines()
            current = (desktop_exec_line() in content
                       and all(f"x-scheme-handler/{scheme};" in "\n".join(content)
                               for scheme in configured_schemes()))
        except FileNotFoundError:
            pass
    print(json.dumps({"handler": handler, "current": current}))


def show_gui(_args):
    require_desktop_user()
    try:
        from link_provider_gui import show_window
    except (ImportError, ValueError) as exc:
        system_python = Path("/usr/bin/python3")
        if system_python.is_file() and Path(sys.executable).resolve() != system_python.resolve():
            os.execv(system_python, [str(system_python), str(Path(__file__).resolve()), "gui"])
        raise LinkError("The graphical interface requires python3-gi and GTK 3 (gir1.2-gtk-3.0).") from exc
    show_window(Path(__file__).resolve(), read_links, LinkError, DESKTOP_ID, lan_settings, configured_schemes)


def desktop_launch(args):
    if args.id is None:
        show_gui(args)
    else:
        if "://" not in args.id:
            raise LinkError("The desktop handler requires an exact configured scheme://ID URI.")
        parse_id(args.id)
        args.action = "open"
        use_link(args)


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--version", action="version", version=f"Link Provider {VERSION}")
    commands = parser.add_subparsers(dest="action", required=True)
    commands.add_parser("gui", help="open the graphical link manager").set_defaults(run=show_gui)
    password = commands.add_parser("set-lan-password")
    password.add_argument("--stdin", action="store_true", help=argparse.SUPPRESS)
    password.set_defaults(run=set_lan_password)
    scheme = commands.add_parser("add-scheme", help="add an opt-in desktop URI scheme")
    scheme.add_argument("scheme")
    scheme.set_defaults(run=configure_scheme)
    settings = commands.add_parser("configure-lan", help="save LAN listener and TLS settings")
    settings.add_argument("--bind", default="0.0.0.0")
    settings.add_argument("--host", required=True)
    settings.add_argument("--port", type=int, choices=range(1, 65536), default=8765, metavar="PORT")
    settings.add_argument("--http-port", type=int, choices=range(0, 65536), default=8764, metavar="PORT")
    settings.add_argument("--cert", default="")
    settings.add_argument("--key", default="")
    settings.set_defaults(run=configure_lan)
    commands.add_parser("start-lan", help="serve using saved LAN settings").set_defaults(run=serve_saved_lan)
    lan = commands.add_parser("serve-lan", help="serve authorized application presets over HTTPS")
    lan.add_argument("--bind", required=True)
    lan.add_argument("--host", required=True)
    lan.add_argument("--port", type=int, choices=range(1, 65536), metavar="PORT", default=8765)
    lan.add_argument("--http-port", type=int, choices=range(0, 65536), default=0, metavar="PORT")
    lan.add_argument("--cert", required=True)
    lan.add_argument("--key", required=True)
    lan.set_defaults(run=serve_lan)
    desktop = commands.add_parser("desktop", help="open the manager or a desktop command link")
    desktop.add_argument("id", nargs="?")
    desktop.set_defaults(run=desktop_launch)
    for action, help_text in (
        ("add", "register a URI"), ("edit", "replace a target with a URI"),
        ("add-app", "register a local executable"), ("edit-app", "replace a target with an executable"),
        ("allow-lan", "authorize an application preset for LAN access"),
        ("deny-lan", "revoke LAN access for an application preset"),
        ("enable", "enable a link"), ("disable", "disable a link"), ("remove", "delete a link"),
    ):
        command = commands.add_parser(action, help=help_text)
        command.add_argument("id")
        if action in {"add", "edit"}:
            command.add_argument("uri")
        if action in {"add-app", "edit-app"}:
            command.add_argument("program")
            command.add_argument("arguments", nargs=argparse.REMAINDER)
        command.set_defaults(run=change_link)

    command = commands.add_parser("list", help="list saved links")
    command.add_argument("--json", action="store_true")
    command.set_defaults(run=list_links)

    for action, help_text in (
        ("check", "check HTTP response, desktop handler or executable"),
        ("open", "open a registered link"), ("test", "perform a real launch"),
    ):
        command = commands.add_parser(action, help=help_text)
        command.add_argument("id", help="link ID or caldav-run://ID URI")
        command.set_defaults(run=use_link)

    for action, help_text in (("link", "print a shareable URI"), ("copy", "copy a shareable URI")):
        command = commands.add_parser(action, help=help_text)
        command.add_argument("id")
        command.add_argument("--scheme", help="configured desktop scheme")
        command.add_argument("--target", action="store_true", help="use the underlying URI")
        command.add_argument("--marker", action="store_true", help="prefix with CALDAV-OPEN:")
        command.set_defaults(run=share_link)

    for action, help_text in (
        ("register-handler", "register caldav-run with the current desktop user"),
        ("unregister-handler", "remove the current user's Link Provider desktop handler"),
        ("handler-status", "show the current caldav-run desktop handler"),
    ):
        command = commands.add_parser(action, help=help_text)
        if action == "handler-status":
            command.add_argument("--details", action="store_true", help="include current launcher status as JSON")
            command.set_defaults(run=show_handler)
        else:
            command.set_defaults(run=change_handler)

    args = parser.parse_args(sys.argv[1:] or ["gui"])
    try:
        args.run(args)
    except (LinkError, OSError, ValueError, subprocess.TimeoutExpired) as exc:
        print(f"Error: {exc}", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
